# ============================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================
DB_NAME=everwod_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# ============================================
# MODELOS DE IA
# ============================================
# Modelo para embeddings (recomendado: sentence-transformers)
FAQ_EMBEDDING_MODEL=all-MiniLM-L6-v2
MIN_EMBEDDING_WORDS=3

# Modelo LLM para generar respuestas (Ollama)
FAQ_LLM_MODEL=llama2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_TIMEOUT=30

# ============================================
# UMBRALES DE SIMILITUD (0.0 a 1.0)
# ============================================
# Muy similar: agrupar mensajes casi idénticos
FAQ_SIMILARITY_VERY_SIMILAR=0.95

# Relacionados: mensajes sobre el mismo tema
FAQ_SIMILARITY_RELATED=0.75

# Medianamente similar
FAQ_SIMILARITY_MEDIUM=0.50

# ============================================
# PROCESAMIENTO DE TEXTO
# ============================================
MIN_TEXT_LENGTH=10
BATCH_SIZE=32
EMBEDDING_BATCH_SIZE=32

# ============================================
# CACHÉ
# ============================================
ENABLE_CACHE=true
CACHE_TTL_HOURS=24

# ============================================
# CLUSTERING - CONFIGURACIÓN GENERAL
# ============================================
# Umbral para elegir algoritmo: <20 mensajes = DBSCAN, >=20 = HDBSCAN
CLUSTERING_SMALL_DATASET_THRESHOLD=20
CLUSTERING_MIN_CLUSTER_MESSAGES=2
MAX_CLUSTER_MESSAGES=100

# ============================================
# CLUSTERING - DBSCAN (para datasets pequeños)
# ============================================
# Controla qué tan cerca deben estar los puntos para agruparse
CLUSTERING_DBSCAN_EPS=0.45
CLUSTERING_DBSCAN_MIN_SAMPLES=1

# ============================================
# CLUSTERING - HDBSCAN (para datasets grandes)
# ============================================
CLUSTERING_HDBSCAN_MIN_CLUSTER_SIZE=1
CLUSTERING_HDBSCAN_MIN_SAMPLES=1
CLUSTERING_HDBSCAN_EPSILON=0.01
